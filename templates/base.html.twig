<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}flotor.fr{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}{% endblock %}">
        <link rel="canonical" href="{% block canonical %}{{ site_url ~ app.request.pathInfo }}{% endblock %}">
        <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">

        <meta property="og:type" content="website">
        <meta property="og:locale" content="fr_FR">
        <meta property="og:site_name" content="flotor.fr">
        <meta property="og:title" content="{{ block('title') }}">
        <meta property="og:description" content="{{ block('meta_description') }}">
        <meta property="og:url" content="{{ block('canonical') }}">
        <meta property="og:image" content="{{ site_url ~ asset('og-image.png') }}">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:image:alt" content="Un bac à sable en verre vu de dessus, avec des dunes et un lac">
        <meta name="twitter:card" content="summary_large_image">
        <meta name="theme-color" content="#e9eef3">
        {% if google_site_verification %}
            <meta name="google-site-verification" content="{{ google_site_verification }}">
        {% endif %}

        {% block structured_data %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
        {% if umami_website_id %}
            {# Umami, cookieless. Auto-tracking is off: one pageview without query string, then custom events. #}
            <script defer src="https://cloud.umami.is/script.js" data-website-id="{{ umami_website_id }}"
                    data-auto-track="false" data-do-not-track="true"
                    onload="umami.track(function (props) { return Object.assign({}, props, { url: location.pathname }); })"></script>
        {% endif %}
    </head>
    <body class="{% block body_class %}{% endblock %}">
        <header class="topbar">
            <a class="brand" href="{{ path('home') }}">
                <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
                    <path d="M3 22c4-6 8-9 13-9s9 3 13 9z" fill="#e3b778"/>
                    <path d="M3 22c3 2 6 3 9 3s6-1 9-3 5-2 8-1v5H3z" fill="#3fa7d6"/>
                </svg>
                <span>flotor<span class="brand-tld">.fr</span></span>
            </a>
            <nav class="mode-switch" aria-label="Choisir le bac">
                <a href="{{ path('home') }}"{% if app.current_route == 'home' %} aria-current="page"{% endif %}>Bac à sable</a>
                <a href="{{ path('ocean') }}"{% if app.current_route == 'ocean' %} aria-current="page"{% endif %}>Bac à houle</a>
            </nav>
            <nav class="topbar-nav" aria-label="Navigation principale">
                <a href="{{ app.current_route in ['home', 'ocean'] ? '' : path('home') }}#a-propos">Comment ça marche ?</a>
            </nav>
        </header>

        {% block body %}{% endblock %}
    </body>
</html>
